{
  "manifest_version": 3,
  "name": "Google AI Browser Worker",
  "version": "0.3.34",
  "description": "Nhận job API và điều khiển Google Flow hoặc Gemini trong phiên Chrome đang đăng nhập.",
  "permissions": ["storage", "tabs", "downloads", "alarms", "debugger"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://backend/*",
    "https://*/*",
    "https://labs.google/*",
    "https://gemini.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": { "service_worker": "worker.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://labs.google/fx/*"],
    "js": ["flow-page-bridge.js"],
    "run_at": "document_start",
    "world": "MAIN"
  }, {
    "matches": ["https://labs.google/fx/*"],
    "js": ["flow.js"],
    "run_at": "document_idle"
  }, {
    "matches": ["https://gemini.google.com/*"],
    "js": ["gemini.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_popup": "popup.html", "default_title": "Google AI Browser Worker" }
}
