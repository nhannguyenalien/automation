FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    DISPLAY=:99 \
    FLOW_EXTENSION_API_URL=http://backend:8787 \
    FLOW_EXTENSION_WORKER_ID=coolify-chrome \
    FLOW_EXTENSION_ENABLED=true \
    FLOW_EXTENSION_FORCE_CONFIG=true

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates fonts-liberation fonts-noto-color-emoji gosu jq novnc openbox \
      procps wget websockify x11vnc xvfb \
    && wget -q -O /tmp/google-chrome.deb \
      https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
    && apt-get install -y --no-install-recommends /tmp/google-chrome.deb \
    && rm -f /tmp/google-chrome.deb \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 --shell /bin/bash chrome \
    && mkdir -p /data/chromium /opt/flow-extension \
    && chown -R chrome:chrome /data/chromium /opt/flow-extension

COPY --chown=chrome:chrome flow-extension/ /opt/flow-extension/
COPY --chown=chrome:chrome docker/chrome/entrypoint.sh /usr/local/bin/chrome-entrypoint
RUN chmod +x /usr/local/bin/chrome-entrypoint

WORKDIR /home/chrome
EXPOSE 6080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD pgrep -f google-chrome >/dev/null && pgrep -f websockify >/dev/null || exit 1
ENTRYPOINT ["/usr/local/bin/chrome-entrypoint"]
