FLOW_API_KEY=replace-with-a-long-random-secret
FLOW_WORKER=extension
FLOW_MAX_QUEUED=100
FLOW_MAX_RETRIES=2
FLOW_MAX_PROMPTS=100
FLOW_MAX_IMAGES_PER_JOB=100
FLOW_IMAGE_BATCH_SIZE=10
FLOW_IMAGE_MAX_RETRIES=0
FLOW_CHAT_INLINE_WAIT_MS=20000
FLOW_IMAGE_INLINE_WAIT_MS=2000
FLOW_VIDEO_INLINE_WAIT_MS=2000
FLOW_PROJECT_URL=https://labs.google/fx/vi/tools/flow/project/PROJECT_ID

TURSO_DATABASE_URL=libsql://database-name.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-token

S3_ENDPOINT=https://s3a.schoolsai.work
S3_REGION=us-east-1
S3_BUCKET=flow-images
S3_ACCESS_KEY=replace-with-service-account-access-key
S3_SECRET_KEY=replace-with-service-account-secret-key
S3_PUBLIC_URL=https://s3a.schoolsai.work/flow-images
S3_MANAGE_BUCKET=false

# Chrome container / Coolify
FLOW_EXTENSION_API_URL=http://backend:8787
FLOW_EXTENSION_WORKER_ID=coolify-chrome
FLOW_EXTENSION_ENABLED=true
FLOW_EXTENSION_FORCE_CONFIG=true
FLOW_START_URL=https://gemini.google.com/app
CHROME_SCREEN=1920x1080x24
NOVNC_PASSWORD=replace-with-a-strong-vnc-password
